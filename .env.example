# ============================================================
#  Анонимная обратная связь — пример настроек
#  Скопируйте файл в .env и измените значения:  cp .env.example .env
# ============================================================

# --- Основное -------------------------------------------------
NODE_ENV=development
# Порт и адрес сервера (0.0.0.0 — чтобы работало за прокси/в контейнере)
PORT=3000
HOST=0.0.0.0
# Сколько прокси стоит перед приложением (для корректного IP в rate-limit).
# nginx → 1, Cloudflare + nginx → 2, прямой запуск → 0
TRUST_PROXY_HOPS=1

# --- Безопасность --------------------------------------------
# Обязательно задайте свой секрет для JWT (мин. 32 случайных символа):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Время жизни сессии: 8h, 12h, 1d …
JWT_EXPIRES_IN=8h
# Отправлять cookie только по HTTPS (включайте на боевом домене с сертификатом)
COOKIE_SECURE=false

# --- Первый администратор ------------------------------------
# Если ADMIN_PASSWORD не задан, пароль будет сгенерирован и напечатан при первом запуске.
# ВАЖНО: если в пароле есть # или ; — заключайте значение в кавычки:
#   ADMIN_PASSWORD="Admin#2026pass"
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Пароль демонстрационного преподавателя (логин ivanova), создаётся командой
# `npm run seed -- --demo`. Если пусто — пароль будет случайным.
DEMO_TEACHER_PASSWORD=

# --- Публичный адрес (для QR-кодов и ссылок) -----------------
# Пример: https://feedback.university.ru
PUBLIC_BASE_URL=

# --- Приватность и анти-спам ---------------------------------
# Показывать студентам ФИО преподавателя в каталоге дисциплин (true/false)
SHOW_TEACHER_NAME=true
# Сколько ответов нужно, чтобы преподаватель увидел результаты
# (1 — показывать всегда, 5 — включать отчёт только после 5 анкет)
MIN_ANSWERS_TO_SHOW=1
# Минимальное время заполнения анкеты в миллисекундах (анти-бот проверка)
ANTI_BOT_MIN_FILL_MS=2500

# --- Ограничения частоты запросов ----------------------------
# Количество запросов и окно в минутах
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_SUBMIT=15
RATE_LIMIT_SUBMIT_WINDOW_MIN=60
RATE_LIMIT_API=600
RATE_LIMIT_API_WINDOW_MIN=15

# --- Встраивание в iframe / LMS ------------------------------
# По умолчанию * — анкету можно встраивать в iframe (LMS, сайт кафедры).
# Если встраивание не нужно, ограничьте список источников, например:
#   FRAME_ANCESTORS='self' https://lms.university.ru
FRAME_ANCESTORS=*

# --- Пути данных ---------------------------------------------
# Каталог базы данных и файла секрета (по умолчанию ./data)
#DATA_DIR=./data
#DB_FILE=./data/feedback.sqlite
