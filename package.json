{
  "name": "bogusa-feedback",
  "version": "1.0.0",
  "private": true,
  "description": "Анонимная обратная связь от студентов к преподавателю: анкеты по занятию и итоговые по дисциплине",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "reset": "node server/seed.js --force",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "qr": "node scripts/qr.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.5.0"
  }
}
